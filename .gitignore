# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Data
/data/
backend/data/

# Streamlit app: ignore DBs but keep cache JSONs
streamlit_app/data/*.db
streamlit_app/data/*.db-*
streamlit_app/data/*.db-journal

# Environment
.env
.env.local
*.env.txt
notepad.env.txt

# Build
frontend/dist/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Instagram card output PNGs (regeneratable from HTML via export_all.py)
docs/instagram/output/

# Local scheduler logs (not needed in repo)
streamlit_app/scripts/*.log

# Local runtime state / logs (not needed in repo)
streamlit_app/data/logs/
streamlit_app/data/cache/portfolio_alert_state.json

# Claude Code agent worktrees
.claude/worktrees/
.venv-cache/

# Backtest input pickles (prices/PIT/fundamentals/benchmarks): rebuilt nightly
# on the Mac that runs the batches, 50-100 MB a day of non-delta blobs — too
# much to keep in history. Only the small metadata / membership files are
# tracked. (Render's on-demand /backtest + /factor-backtest endpoints need
# these pickles and therefore no longer have data; the web app reads the
# precomputed grids instead.)
streamlit_app/data/cache/backtest_data/prices.pkl.gz
streamlit_app/data/cache/backtest_data/pit.pkl.gz
streamlit_app/data/cache/backtest_data/fundamentals.pkl.gz
streamlit_app/data/cache/backtest_data/benchmarks.pkl.gz
